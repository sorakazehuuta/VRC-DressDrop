# Supabase（プロジェクト設定 > API Keys）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# publishable key（旧 anon key でも可）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# secret key（旧 service_role key でも可）。サーバー専用。絶対に公開しないこと
SUPABASE_SECRET_KEY=

# PayPal（Phase 7 で使用）
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
