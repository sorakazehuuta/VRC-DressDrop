# Supabase（プロジェクト設定 > API Keys）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# publishable key（旧 anon key でも可）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# secret key（旧 service_role key でも可）。サーバー専用。絶対に公開しないこと
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile（CAPTCHA）のサイトキー。シークレットキーは Supabase の Authentication > Attack Protection に入れる（ここには書かない）
# 開発用のテストキー: 1x00000000000000000000AA（必ず通る）。未設定なら CAPTCHA を出さない（Supabase 側の CAPTCHA も無効にしておく）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Stripe（設定は Document/stripe-setup.md）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 決済画面に出す支払い方法（省略時は card,konbini）
STRIPE_PAYMENT_METHODS=card,konbini

# 本番のサイトの URL（パッケージの LICENSE.txt に載せる利用規約の URL にも使う）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 定期実行（/api/cron/...）の認証。Vercel Cron は Authorization: Bearer <CRON_SECRET> を付けて呼ぶ
CRON_SECRET=
